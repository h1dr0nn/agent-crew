{
  "description": "Agent Crew: keep the crew launcher pointing at this plugin, and run the opt-in stop-time review gate.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/crew\" shim --quiet",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/crew\" hook stop",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
