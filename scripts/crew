#!/bin/sh
# Runs this plugin's crew CLI with the first Python 3.11+ on PATH.
# Used by the plugin's hooks and skills; people use the launcher `crew shim` writes.
here=$(cd "$(dirname "$0")" && pwd)
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
    exec "$py" "$here/crew.py" "$@"
  fi
done
echo "agent-crew: needs Python 3.11 or later on PATH" >&2
exit 3
